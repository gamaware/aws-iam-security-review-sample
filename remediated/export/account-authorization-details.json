{
  "UserDetailList": [
    {
      "Path": "/",
      "UserName": "bob.ops",
      "UserId": "AIDAEXAMPLEBOBOPS0001",
      "Arn": "arn:aws:iam::123456789012:user/bob.ops",
      "GroupList": [
        "PlatformOps"
      ],
      "UserPolicyList": [],
      "AttachedManagedPolicies": []
    }
  ],
  "GroupDetailList": [
    {
      "Path": "/",
      "GroupName": "PlatformOps",
      "GroupId": "AGPAEXAMPLEPLATOPS001",
      "Arn": "arn:aws:iam::123456789012:group/PlatformOps",
      "GroupPolicyList": [],
      "AttachedManagedPolicies": [
        {
          "PolicyName": "platform-ops",
          "PolicyArn": "arn:aws:iam::123456789012:policy/platform-ops"
        },
        {
          "PolicyName": "require-mfa",
          "PolicyArn": "arn:aws:iam::123456789012:policy/require-mfa"
        }
      ]
    }
  ],
  "RoleDetailList": [
    {
      "Path": "/",
      "RoleName": "ci-deploy",
      "RoleId": "AROAEXAMPLECIDEPLOY01",
      "Arn": "arn:aws:iam::123456789012:role/ci-deploy",
      "AssumeRolePolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Sid": "GitHubProductionEnvironmentOnly",
            "Effect": "Allow",
            "Principal": {
              "Federated": "arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com"
            },
            "Action": "sts:AssumeRoleWithWebIdentity",
            "Condition": {
              "StringEquals": {
                "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
                "token.actions.githubusercontent.com:sub": "repo:examplecorp/reporting-app:environment:production"
              }
            }
          }
        ]
      },
      "InstanceProfileList": [],
      "RolePolicyList": [
        {
          "PolicyName": "ci-deploy",
          "PolicyDocument": {
            "Version": "2012-10-17",
            "Statement": [
              {
                "Sid": "ListReleasePrefix",
                "Effect": "Allow",
                "Action": "s3:ListBucket",
                "Resource": "arn:aws:s3:::examplecorp-release-artifacts",
                "Condition": {
                  "StringLike": {
                    "s3:prefix": [
                      "reporting-app/*"
                    ]
                  }
                }
              },
              {
                "Sid": "UploadReleaseArtifacts",
                "Effect": "Allow",
                "Action": [
                  "s3:GetObject",
                  "s3:PutObject"
                ],
                "Resource": "arn:aws:s3:::examplecorp-release-artifacts/reporting-app/*"
              },
              {
                "Sid": "DeployOneFunction",
                "Effect": "Allow",
                "Action": [
                  "lambda:GetFunction",
                  "lambda:UpdateFunctionCode",
                  "lambda:PublishVersion"
                ],
                "Resource": "arn:aws:lambda:us-east-1:123456789012:function:reporting-app"
              }
            ]
          }
        }
      ],
      "AttachedManagedPolicies": []
    },
    {
      "Path": "/aws-service-role/support.amazonaws.com/",
      "RoleName": "AWSServiceRoleForSupport",
      "RoleId": "AROAEXAMPLESUPPORT001",
      "Arn": "arn:aws:iam::123456789012:role/aws-service-role/support.amazonaws.com/AWSServiceRoleForSupport",
      "AssumeRolePolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Principal": {
              "Service": "support.amazonaws.com"
            },
            "Action": "sts:AssumeRole"
          }
        ]
      },
      "InstanceProfileList": [],
      "RolePolicyList": [],
      "AttachedManagedPolicies": []
    }
  ],
  "Policies": [
    {
      "PolicyName": "platform-ops",
      "Arn": "arn:aws:iam::123456789012:policy/platform-ops",
      "Path": "/",
      "DefaultVersionId": "v1",
      "AttachmentCount": 1,
      "IsAttachable": true,
      "PolicyVersionList": [
        {
          "VersionId": "v1",
          "IsDefaultVersion": true,
          "Document": {
            "Version": "2012-10-17",
            "Statement": [
              {
                "Sid": "ListRoles",
                "Effect": "Allow",
                "Action": "iam:ListRoles",
                "Resource": "*"
              },
              {
                "Sid": "ReadRolesForTroubleshooting",
                "Effect": "Allow",
                "Action": [
                  "iam:GetRole",
                  "iam:GetRolePolicy",
                  "iam:ListAttachedRolePolicies"
                ],
                "Resource": "arn:aws:iam::123456789012:role/*"
              },
              {
                "Sid": "PassOnlyAppRolesToEc2WithMfa",
                "Effect": "Allow",
                "Action": "iam:PassRole",
                "Resource": "arn:aws:iam::123456789012:role/app-*",
                "Condition": {
                  "StringEquals": {
                    "iam:PassedToService": "ec2.amazonaws.com"
                  },
                  "Bool": {
                    "aws:MultiFactorAuthPresent": "true"
                  }
                }
              },
              {
                "Sid": "DescribeInstances",
                "Effect": "Allow",
                "Action": [
                  "ec2:DescribeInstances",
                  "ec2:DescribeInstanceStatus",
                  "ec2:DescribeTags"
                ],
                "Resource": "*"
              },
              {
                "Sid": "StopAndTerminatePlatformInstancesOnly",
                "Effect": "Allow",
                "Action": [
                  "ec2:StopInstances",
                  "ec2:TerminateInstances"
                ],
                "Resource": "arn:aws:ec2:*:123456789012:instance/*",
                "Condition": {
                  "StringEquals": {
                    "aws:ResourceTag/team": "platform"
                  }
                }
              }
            ]
          }
        }
      ]
    },
    {
      "PolicyName": "require-mfa",
      "Arn": "arn:aws:iam::123456789012:policy/require-mfa",
      "Path": "/",
      "DefaultVersionId": "v1",
      "AttachmentCount": 1,
      "IsAttachable": true,
      "PolicyVersionList": [
        {
          "VersionId": "v1",
          "IsDefaultVersion": true,
          "Document": {
            "Version": "2012-10-17",
            "Statement": [
              {
                "Sid": "DenyEverythingExceptMfaSetupWithoutMfa",
                "Effect": "Deny",
                "NotAction": [
                  "iam:ChangePassword",
                  "iam:CreateVirtualMFADevice",
                  "iam:EnableMFADevice",
                  "iam:GetUser",
                  "iam:ListMFADevices",
                  "iam:ListVirtualMFADevices",
                  "iam:ResyncMFADevice",
                  "sts:GetSessionToken"
                ],
                "Resource": "*",
                "Condition": {
                  "BoolIfExists": {
                    "aws:MultiFactorAuthPresent": "false"
                  }
                }
              }
            ]
          }
        }
      ]
    }
  ]
}
