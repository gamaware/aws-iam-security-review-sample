{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListReleasePrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::harborgoods-release-artifacts",
      "Condition": {"StringLike": {"s3:prefix": ["reporting-app/*"]}}
    },
    {
      "Sid": "UploadReleaseArtifacts",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::harborgoods-release-artifacts/reporting-app/*"
    },
    {
      "Sid": "DeployOneFunction",
      "Effect": "Allow",
      "Action": ["lambda:GetFunction", "lambda:UpdateFunctionCode", "lambda:PublishVersion"],
      "Resource": "arn:aws:lambda:us-east-1:123456789012:function:reporting-app"
    }
  ]
}
