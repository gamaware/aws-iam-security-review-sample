{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublicReadForPartnerDownloads",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::examplecorp-customer-exports/*"
    },
    {
      "Sid": "AnalyticsVendorAccess",
      "Effect": "Allow",
      "Principal": {"AWS": "arn:aws:iam::111122223333:root"},
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::examplecorp-customer-exports",
        "arn:aws:s3:::examplecorp-customer-exports/*"
      ]
    }
  ]
}
