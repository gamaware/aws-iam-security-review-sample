{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyInsecureTransport",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::examplecorp-customer-exports",
        "arn:aws:s3:::examplecorp-customer-exports/*"
      ],
      "Condition": {"Bool": {"aws:SecureTransport": "false"}}
    },
    {
      "Sid": "PartnerListsItsPrefix",
      "Effect": "Allow",
      "Principal": {"AWS": "arn:aws:iam::111122223333:role/partner-ingest"},
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::examplecorp-customer-exports",
      "Condition": {"StringLike": {"s3:prefix": ["partner-a/*"]}}
    },
    {
      "Sid": "PartnerReadsItsPrefix",
      "Effect": "Allow",
      "Principal": {"AWS": "arn:aws:iam::111122223333:role/partner-ingest"},
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::examplecorp-customer-exports/partner-a/*"
    }
  ]
}
