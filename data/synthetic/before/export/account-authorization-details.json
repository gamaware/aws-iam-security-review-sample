      "RoleName": "ci-deploy",
      "RoleId": "AROAEXAMPLECIDEPLOY01",
      "Arn": "arn:aws:iam::111122223333:role/ci-deploy",
      "AssumeRolePolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Principal": {
              "Federated": "arn:aws:iam::111122223333:oidc-provider/token.actions.githubusercontent.com"
